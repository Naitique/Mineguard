// ===========================================================================
// secrets.h.example  --  template for Wi-Fi credentials.
//
// Copy this file to "secrets.h" (same folder) and fill in your real network
// name/password. secrets.h is git-ignored -- it will never be committed.
// This .example file has no real credentials, so it's safe to track in git.
//
//   cp firmware/src/secrets.h.example firmware/src/secrets.h
//
// Only needed if ENABLE_WIFI_FORWARD is set to 1 in config.h.
// ===========================================================================
#pragma once

#define WIFI_SSID     "your-network-name"
#define WIFI_PASSWORD "your-network-password"
